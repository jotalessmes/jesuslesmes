# URL Postgres agrupada de Neon (postgresql://…).
DATABASE_URL=
# Acceso por contraseña mientras no configures NEON_ADMIN_USER_ID.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Acceso por Neon Auth. Al indicar el ID, sustituye al acceso por ADMIN_PASSWORD.
NEON_ADMIN_USER_ID=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Actualización automática del panel.
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
# Comprobación de la función hello.
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=
# Comprobación del bucket privado assets.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Comprobación del catálogo AI Gateway.
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
